{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "assignees": ["zimavi"],
  "reviewers": ["zimavi"],

  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "assignAutomerge": true,

  "packageRules": [
    {
      "description": "Update Cosmos SDK, kernel packages, and project CosmosVersion together",
      "matchPackageNames": [
        "Cosmos.Sdk",
        "Cosmos.Kernel",
        "Cosmos.Kernel.System",
      ],
      "groupName": "Cosmos packages",
      "groupSlug": "cosmos-packages",
      "separateMajorMinor": false,
      "separateMinorPatch": false
    }
  ],

  "customManagers": [
    {
      "customType": "regex",
      "description": "Update CosmosVersion property using Cosmos.Kernel versions",
      "managerFilePatterns": [
        "/^src/Yukihana/Yukihana\\.csproj$/"
      ],
      "matchStrings": [
        "<CosmosVersion>(?<currentValue>[^<]+)</CosmosVersion>"
      ],
      "depNameTemplate": "CosmosVersion",
      "packageNameTemplate": "Cosmos.Kernel",
      "datasourceTemplate": "nuget",
      "versioningTemplate": "nuget",
      "autoReplaceStringTemplate": "<CosmosVersion>{{{newValue}}}</CosmosVersion>"
    }
  ]
}
